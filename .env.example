# Copy to .env.local and fill in values. Restart `npm run dev` after changes.

# Production (Vercel): set to https://ellzluxefragranz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# Project URL looks like: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (server only — never put this in client code)
SUPABASE_SERVICE_ROLE_KEY=

# Optional until you take live payments
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Moolre (Ghana MoMo / hosted checkout). Create an API Service on the wallet, then paste:
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_BUSINESS_EMAIL=

# Optional: email the annex and the customer when an order is placed (WhatsApp still opens)
RESEND_API_KEY=
# Verified Resend sender, e.g. EllzLuxe Fragranz <orders@your-domain>
ORDER_NOTIFY_FROM=
ORDER_NOTIFY_WEBHOOK_URL=
CALLMEBOT_API_KEY=
ORDER_NTFY_TOPIC=

# Cloudflare R2 for bottle photos. Leave blank until the images hostname is live.
# Dashboard: R2 → ellz-product-images → API token with object read and write on that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ellz-product-images
R2_PUBLIC_BASE_URL=https://images.ellzluxefragranz.com
