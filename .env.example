# Copy to .env.local and fill in values. Restart `npm run dev` after changes.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# Project URL looks like: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key (safe for the browser; RLS still applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (server only — never put this in client code)
SUPABASE_SERVICE_ROLE_KEY=

# Optional until you take live payments
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Moolre (Ghana MoMo / hosted checkout). Create an API Service on the wallet, then paste:
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_BUSINESS_EMAIL=
